# LibreTexts Remedy — environment template
# Copy to .env and fill in. .env is git-ignored.
# NEVER commit real secrets.

# --- CXone Expert (MindTouch / Deki) ---
# Hostname of the target instance (no protocol).
SERVER_DOMAIN=dev.libretexts.org

# Service-account credentials for signed X-Deki-Token auth.
# Scope: Sandboxes namespace only for MVP.
SERVER_KEY=
SERVER_SECRET=
SERVER_USER=

# --- LLM provider (used by rule fixers) ---
# One client, OpenAI-compatible payload, any of these providers.
# Set REMEDY_LLM_PROVIDER to pick one.
REMEDY_LLM_PROVIDER=openrouter            # openrouter | ollama-cloud | ollama-local | gemini-compat | custom
# REMEDY_LLM_BASE_URL=                    # only needed for provider=custom
# REMEDY_LLM_API_KEY=                     # takes precedence over the provider-specific key below
REMEDY_TEXT_MODEL=                        # leave blank for provider default
REMEDY_VISION_MODEL=                      # leave blank for provider default

# Provider-specific keys (pick the ones you use)
OPENROUTER_API_KEY=
OLLAMA_API_KEY=                           # Ollama Cloud subscription
GEMINI_API_KEY=
# For any other OpenAI-compatible provider, set REMEDY_LLM_PROVIDER=custom with
# REMEDY_LLM_BASE_URL and REMEDY_LLM_API_KEY above — no other vendor-specific
# key slots are read, so none are listed here.

# Optional OpenRouter attribution headers (shown in their dashboard)
REMEDY_OPENROUTER_REFERER=https://github.com/libretexts
REMEDY_OPENROUTER_APP=libretexts-remedy

# --- Remedy behavior ---
# Comma-separated regex list of page paths allowed for WRITE operations.
# Default locks writes to Sandboxes/ only. Expanding requires deliberate change.
REMEDY_WRITE_ALLOWLIST=^Sandboxes/

# Path for the append-only audit log of every apply.
REMEDY_AUDIT_LOG=.remedy/audit.log

# Conductor panel API server (local staff tool). Binds to loopback by default;
# change the host only deliberately, and add auth before exposing it off-host.
CONDUCTOR_API_HOST=127.0.0.1
# CONDUCTOR_API_PORT=5175
# Max accepted request body size (bytes) for the panel API.
REMEDY_MAX_REQUEST_BYTES=5000000

# SSRF guard for outbound image fetches. Empty = allow any PUBLIC host (private,
# loopback, link-local and cloud-metadata addresses are always blocked). Set a
# comma-separated host-suffix list for a strict positive allowlist, e.g.
# REMEDY_IMAGE_FETCH_ALLOWLIST=libretexts.org,cdn.mathpix.com
REMEDY_IMAGE_FETCH_ALLOWLIST=

# Set to 1 for verbose Remedy debug logging (safe — never prints secrets).
DEBUG=
# Set to 1 ONLY to debug the CXone SDK itself. This can print the signed
# X-Deki-Token credential to the console — keep it off outside local debugging.
REMEDY_SDK_DEBUG=
